[submodule "ninjatrader-scripts"]
	path = ninjatrader-scripts
	url = git@github.com:MattyTheHacker/ninjatrader-scripts.git
	branch = main

[submodule "Trading-Docs"]
	path = Trading-Docs
	url = git@github.com:MattyTheHacker/Trading-Docs.git
	branch = main
	# Dependabot cannot clone this private repo, so a clone skips it: README.md, "Install".
	update = none
